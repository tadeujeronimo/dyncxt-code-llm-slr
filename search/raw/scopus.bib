@CONFERENCE{Xu20261975,
	author = {Xu, Shiyuan and Yuan, Junwei and Si, Menghui},
	title = {LLM-SCE: A Large Language Model-Driven Framework for Strategic Consulting Evaluation with Multi-Agent Reasoning and Domain-Adaptive Retrieval},
