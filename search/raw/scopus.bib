@CONFERENCE{Li2026546,
	author = {Li, Bo and Ma, Li and Wang, Dan and Ji, Shiyu and Shi, He},
	title = {C/C++ Code Security Auditing Agent Based on Hybrid Multi-Strategy Retrieval Enhancement},
	year = {2026},
	journal = {2026 7th International Seminar on Artificial Intelligence, Networking and Information Technology, AINIT 2026},
	pages = {546 - 549},
	doi = {10.1109/AINIT70033.2026.11557899},
	url = {https://www.scopus.com/pages/publications/105043705784?origin=resultslist},
	abstract = {Traditional code analysis tools suffer from high false positive rates and limited context understanding, while directly applying large language models (LLMs) to code auditing often leads to hallucinations and context window constraints. To address these issues, this paper proposes a C/C++ Code Security Auditing Agent Based on Hybrid Multi-Strategy Retrieval Enhancement. The method constructs a workflow based on the LangGraph framework and designs a Hybrid Multi-Strategy candidate code block screening strategy that integrates BM25 keyword retrieval, FAISS semantic vector retrieval, and regular expression pattern matching. Static scanning tool results are incorporated as evidence chain supplementation. A ReAct-based agent reasoning mechanism is introduced to enable complex call chain tracing and autonomous cross-function context extension. Additionally, an innovative vulnerability validity verification mechanism is proposed to classify detection results into three categories: valid vulnerabilities, potential risks, and false positives. The proposed method successfully detects major vulnerability categories including memory safety issues (buffer overflows, use-after-free, null pointer dereferences), integer overflows, and array bound violations. Experiments conducted with a locally deployed Qwen3-32B LLM on eight industrial-grade C/C++ code repositories demonstrate that the proposed method achieves a precision of 84.4% and a recall of 76.0%, reducing the false positive rate by approximately 61 percentage points compared to traditional static analysis tools. The results confirm that the method significantly improves the accuracy and practicality of vulnerability detection while supporting fully local deployment and offline operation, providing an efficient and reliable solution for embedded and kernel-level code security auditing. © 2026 IEEE.},
