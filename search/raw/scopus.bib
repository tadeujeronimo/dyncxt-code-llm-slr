@ARTICLE{Wu2026,
	author = {Wu, Li and Wei, Jiqing and Wu, Yonghao and Du, Bin and Zhao, Ruilian and Liu, Yong},
	title = {SHARE-RAG: A structure-aware and hypothesis-guided retrieval-augmented framework for fault localization in novice programs},
	year = {2026},
	journal = {Journal of Systems and Software},
	volume = {242},
	pages = {},
	doi = {10.1016/j.jss.2026.113057},
	url = {https://www.scopus.com/pages/publications/105046320550?origin=resultslist},
	abstract = {Fault localization is a critical yet challenging task in software debugging, particularly for novice programmers whose programs often contain diverse logical and structural faults. Although Large Language Models (LLMs) demonstrate robust code reasoning capabilities, their effectiveness is frequently limited by the semantic gap between faulty program queries and correct reference implementations. To address this mismatch, we propose SHARE-RAG, an adaptive framework based on cascaded retrieval paradigm. Fundamentally, SHARE-RAG is driven by two synergistic components: Structure-Aware Retrieval and Reflection-Triggered Hypothesis-Guided Repair. The framework first aligns programs at a deep behavioral level using multi-dimensional structural features (AST, CFG, and DFG). If an LLM-driven reflection mechanism determines that this purely structural context is inadequate, it dynamically initiates a hypothesis-guided repair. This fallback strategy generates a hypothetical fix, effectively transforming the search query from erroneous logic to the intended correct semantics. Finally, the highly relevant evidence is injected into the LLM via Chain-of-Thought prompting, empowering the model to conduct precise fault localization by outputting a prioritized list of suspicious code lines along with interpretable diagnostic explanations. Extensive experiments on the TutorCode benchmark across ten diverse LLMs demonstrate that SHARE-RAG significantly outperforms traditional heuristics and standard RAG baselines. Integrating Structure-Aware Retrieval and Reflection-Triggered Hypothesis-Guided Repair substantially improves localization accuracy, explanation quality, and cross-model ranking robustness. Notably, SHARE-RAG excels at empowering resource-constrained models, improving Qwen3-1.7b's Top-1 accuracy by 10.6% over its non-RAG baseline. © 2026 Elsevier Inc.},
	author_keywords = {Fault localization; Large Language Model; Novice programming; Retrieval-Augmented Generation; Structural program analysis},
	keywords = {Codes (symbols); Computer software; Formal logic; Logic programming; Program debugging; Query processing; Semantics; Fault localization; Language model; Large language model; Novice programming; Program analysis; Retrieval-augmented generation; Software debugging; Structural program analyze; Structural programs; Structure-aware; Repair},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

