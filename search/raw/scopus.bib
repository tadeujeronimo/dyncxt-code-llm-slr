	title = {Reducing False Positives in Static Bug Detection with LLMs: An Empirical Study in Industry},
	year = {2026},
	journal = {Proceedings - 2026 IEEE/ACM 48th International Conference on Software Engineering: Software Engineering in Practice, ICSE-SEIP 2026},
