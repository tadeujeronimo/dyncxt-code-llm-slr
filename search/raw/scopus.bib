@ARTICLE{Wang2025,
	author = {Wang, Zi and Zhu, Xiaoyu and Wang, Hongqiang and Yu, Yichun and Lan, Yuqing},
	title = {KerSpecGen: Co-piloting formal Kernel specification synthesis with refined knowledge graphs and large language models},
