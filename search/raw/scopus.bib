@ARTICLE{Chen2026,
	author = {Chen, Mantun and Cheng, Hua and Su, Ting and Chen, Minghui and Cai, Wenjun and Zou, Hongcheng},
	title = {Evaluating Large Language Models in Cybersecurity: A Systematic Taxonomy and Empirical Analysis},
	year = {2026},
	journal = {Electronics (Switzerland)},
