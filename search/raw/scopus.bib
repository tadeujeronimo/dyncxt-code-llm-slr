}

@CONFERENCE{Tang2025134,
	author = {Tang, Yongjian and Tuncel, Doruk and Koerner, Christian and Runkler, Thomas},
	title = {The Few-shot Dilemma: Over-prompting Large Language Models},
	year = {2025},
	journal = {2025 3rd International Conference on Foundation and Large Language Models, FLLM 2025},
	pages = {134 - 141},
	doi = {10.1109/FLLM67465.2025.11391015},
	url = {https://www.scopus.com/pages/publications/105035829752?origin=resultslist},
	abstract = {Over-prompting, a phenomenon where excessive examples in prompts lead to diminished performance in Large Language Models (LLMs), challenges the conventional wisdom about in-context few-shot learning. To investigate this few-shot dilemma, we outline a prompting framework that leverages three standard few-shot selection methods - random sampling, semantic embedding, and TF-IDF vectors - and evaluate these methods across multiple LLMs, including GPT-4o, GPT-3.5-turbo, DeepSeek-V3, Gemma-3, LLaMA-3.1, LLaMA-3.2, and Mistral. Our experimental results reveal that incorporating excessive domain-specific examples into prompts can paradoxically degrade performance in certain LLMs, which contradicts the prior empirical conclusion that more relevant few-shot examples universally benefit LLMs. Given the trend of LLM-assisted software engineering and requirement analysis, we experiment with two real-world software requirement classification datasets. By gradually increasing the number of TF-IDF-selected and stratified few-shot examples, we identify their optimal quantity for each LLM. This combined approach achieves superior performance with fewer examples, avoiding the over-prompting problem, thus surpassing the state-of-the-art by 1% in classifying functional and non-functional requirements. © 2025 IEEE.},
	author_keywords = {classification; few-shot; LLMs; prompting; software requirements},
	keywords = {Artificial intelligence; Computer aided software engineering; Computer software; Requirements engineering; Few-shot; In contexts; Language model; Large language model; Performance; Prompting; Random sampling; Selection methods; Semantic embedding; Software requirements; Classification (of information)},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 4; All Open Access; Green Open Access}
}

@ARTICLE{Sisomboon202631124,
	author = {Sisomboon, Wantana and Kaewyotha, Jakkrit and Songpan, Wararat},
	title = {Automated Software Test Case Generation Using Directional Partially Weighted Ensemble Large Language Models With Retrieval-Augmented Generation (RAG)},
	year = {2026},
	journal = {IEEE Access},
	volume = {14},
	pages = {31124 - 31145},
	doi = {10.1109/ACCESS.2026.3667925},
	url = {https://www.scopus.com/pages/publications/105031476496?origin=resultslist},
	abstract = {Ensuring software quality relies on testing practices that can reliably confirm whether delivered systems meet user requirements. While Acceptance Test-Driven Development (ATDD) encourages early collaboration between stakeholders and developers, creating comprehensive acceptance test cases remains a human task that heavily depends on domain expertise. Recent progress in Large Language Models (LLMs) has made automated test case generation feasible. However, approaches based on a single model often suffer from performance instability, uneven test coverage, and a limited ability to generalize across heterogeneous requirements. This study proposes an automated test case generation framework that combines directional partially weighted ensemble large language models (LLMs) with Retrieval-Augmented Generation (RAG). The framework assigns model influence dynamically according to directional performance trends and degrees of partial correctness and consolidates candidate outputs through a weighted majority-voting mechanism and cross-validation conducted over multiple folds. Five state-of-the-art LLMs, Claude, ChatGPT, Gemini, Qwen, and Mistral, were evaluated using 16 criteria derived from four widely adopted closed box testing techniques: Boundary Value Analysis, Equivalence Partitioning, Use Case testing, and State Transition testing. Under the evaluated experimental conditions, the proposed framework achieved 98.44% test coverage, indicating complete consistency with the defined gold-standard acceptance criteria. Cross-validation results further demonstrate improved robustness, stronger generalization to previously unseen requirements, and linear scalability, supporting practical deployment in real-world software development environments, and complexity analysis to confirm linear throughout growth (O(n)), which supports efficient deployment under increasing workloads. © 2013 IEEE.},
	author_keywords = {ATDD; automated software testing; directional partially; LLM; RAG; test coverage; weighted ensemble},
	keywords = {Automatic test pattern generation; Automation; Black-box testing; Computer software selection and evaluation; Human computer interaction; Model checking; Software design; Software quality; Acceptance test-driven development; Automated software testing; Automated test-case generations; Directional partially; Language model; Large language model; Retrieval-augmented generation; Test driven development; Test-coverage; Weighted ensemble; Acceptance tests},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 4; All Open Access; Gold Open Access}
}

