@CONFERENCE{Fregnan2025,
	author = {Fregnan, Enrico and Gottel, Christian and Maag, Balz and Dawoud, Abdallah and Nakas, Georgios},
	title = {Leveraging LLMs Towards Assistant-based Support for Industrial Threat Models},
